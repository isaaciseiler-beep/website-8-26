OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_API remains supported as a legacy alias.
# OPENAI_API=sk-your-openai-api-key

# Best-quality public assistant defaults.
OPENAI_CHAT_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=high
OPENAI_VERIFIER_MODEL=gpt-5.6-luna
OPENAI_VERIFIER_EFFORT=low
OPENAI_ASSISTANT_VERIFY=true
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1024

# Feedback stores hashes and operational metadata unless explicitly opted in.
ASSISTANT_STORE_CONTENT=false

# Optional map routes.
# VITE_MAPBOX_ACCESS_TOKEN=pk_your_token_here
# NEXT_PUBLIC_MAPBOX_TOKEN=pk_your_token_here
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk_your_token_here
# Optional shared storage for Fulbright Map and Strike Tracker.
# Run supabase/fulbrightmap-schema.sql and supabase/strike-tracker-schema.sql.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key

# Optional Strike Tracker server API.
# STRIKE_TRACKER_ACCESS_CODE=replace-this
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
