OPENAI_API=sk-your-openai-api-key
# Optional. Defaults to gpt-4.1-mini in api/chat.ts.
# OPENAI_CHAT_MODEL=gpt-4.1-mini

# Optional map routes.
# VITE_MAPBOX_ACCESS_TOKEN=pk_your_token_here
# NEXT_PUBLIC_MAPBOX_TOKEN=pk_your_token_here
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk_your_token_here
# Optional shared storage for Fulbright Map and Strike Tracker.
# Run supabase/fulbrightmap-schema.sql and supabase/strike-tracker-schema.sql.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key

# Optional Strike Tracker server API.
# STRIKE_TRACKER_ACCESS_CODE=replace-this
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
