{
  "headers": [
    {
      "source": "/writing.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/index.md",
      "headers": [
        {
          "key": "Link",
          "value": "<https://seiler.page/>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/about.md",
      "headers": [
        {
          "key": "Link",
          "value": "<https://seiler.page/about>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/work.md",
      "headers": [
        {
          "key": "Link",
          "value": "<https://seiler.page/work>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/agents.md",
      "headers": [
        {
          "key": "Link",
          "value": "<https://seiler.page/agents>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/photos/map.md",
      "headers": [
        {
          "key": "Link",
          "value": "<https://seiler.page/photos/map>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/projects/:project.md",
      "headers": [
        {
          "key": "Link",
          "value": "<https://seiler.page/projects/:project>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/fulbrightmap",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/isaac-seiler-resume(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/experience/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/project-images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/seo/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.seiler.page"
        }
      ],
      "destination": "https://seiler.page/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "isaacseiler.xyz"
        }
      ],
      "destination": "https://seiler.page/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.isaacseiler.xyz"
        }
      ],
      "destination": "https://seiler.page/:path*",
      "permanent": true
    },
    {
      "source": "/photos",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/projects/electric-vehicle-access-analysis",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/latest",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/latest/(.*)",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/summation-ai",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/openai-student-collective",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/truman-scholar",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/truman-scholarship",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/rhodes-scholarship",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/washu",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/experience",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/credentials",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/ai-state-government-index",
      "destination": "/projects/artificial-intelligence-in-state-government-index",
      "permanent": true
    },
    {
      "source": "/ai-government-index",
      "destination": "/projects/artificial-intelligence-in-state-government-index",
      "permanent": true
    },
    {
      "source": "/ai-journalism-research",
      "destination": "/projects/senior-thesis-local-journalism",
      "permanent": true
    },
    {
      "source": "/resume",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/projects/communications-consultancy-supporting-local-candidates",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/projects/2022-institute-for-nonprofit-news-index-survey",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/projects/exclusive-interview-with-high-visibility-congressperson",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/projects/fulbright-award-to-taiwan",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/writing/a-place-for-questions",
      "destination": "/writing",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/writing",
      "destination": "/writing/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/work",
      "destination": "/work/index.html"
    },
    {
      "source": "/agents",
      "destination": "/agents/index.html"
    },
    {
      "source": "/projects/fulbright-focus-group-sponsored-by-openai",
      "destination": "/projects/fulbright-focus-group-sponsored-by-openai/index.html"
    },
    {
      "source": "/projects/artificial-intelligence-in-state-government-index",
      "destination": "/projects/artificial-intelligence-in-state-government-index/index.html"
    },
    {
      "source": "/projects/senior-thesis-local-journalism",
      "destination": "/projects/senior-thesis-local-journalism/index.html"
    },
    {
      "source": "/projects/congressional-office-setup-100-day-report",
      "destination": "/projects/congressional-office-setup-100-day-report/index.html"
    },
    {
      "source": "/projects/boehringer-cares-foundation-rebrand-strategy-shift",
      "destination": "/projects/boehringer-cares-foundation-rebrand-strategy-shift/index.html"
    },
    {
      "source": "/projects/stl-immigrant-refugee-support-grant-process",
      "destination": "/projects/stl-immigrant-refugee-support-grant-process/index.html"
    },
    {
      "source": "/projects/openai-product-testing-and-feedback",
      "destination": "/projects/openai-product-testing-and-feedback/index.html"
    },
    {
      "source": "/api/public/:path*",
      "destination": "/api/public-content?path=:path*"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/photos/map",
      "destination": "/photos/map/index.html"
    },
    {
      "source": "/photos/music",
      "destination": "/index.html"
    },
    {
      "source": "/experience/arcade",
      "destination": "/index.html"
    },
    {
      "source": "/fulbrightmap",
      "destination": "/index.html"
    },
    {
      "source": "/strike-tracker",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/*.ts": {
      "includeFiles": "{knowledge/**,.mcp-build/**}"
    }
  }
}
