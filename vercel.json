{
  "headers": [
    {
      "source": "/fulbrightmap",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/isaac-seiler-resume(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/experience/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/project-images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/seo/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/blog",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/writing",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/latest",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/latest/(.*)",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/summation-ai",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/openai-student-collective",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/truman-scholar",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/truman-scholarship",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/rhodes-scholarship",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/washu",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/experience",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/credentials",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/ai-state-government-index",
      "destination": "/projects/artificial-intelligence-in-state-government-index",
      "permanent": true
    },
    {
      "source": "/ai-government-index",
      "destination": "/projects/artificial-intelligence-in-state-government-index",
      "permanent": true
    },
    {
      "source": "/ai-journalism-research",
      "destination": "/projects/senior-thesis-local-journalism",
      "permanent": true
    },
    {
      "source": "/resume",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/work",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/fulbrightmap",
      "destination": "/index.html"
    },
    {
      "source": "/strike-tracker",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/*.ts": {
      "includeFiles": "knowledge/**"
    }
  }
}
